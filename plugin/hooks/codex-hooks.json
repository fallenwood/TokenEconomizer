{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/te-hook\" --host codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"exit (Start-Process -Wait -NoNewWindow -PassThru -FilePath (Join-Path ([string]::Concat([Environment]::GetEnvironmentVariable('PLUGIN_ROOT','Process'),[Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT','Process'))) 'scripts\\te-hook.cmd') -ArgumentList '--host','codex').ExitCode\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/te-hook\" --host codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"exit (Start-Process -Wait -NoNewWindow -PassThru -FilePath (Join-Path ([string]::Concat([Environment]::GetEnvironmentVariable('PLUGIN_ROOT','Process'),[Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT','Process'))) 'scripts\\te-hook.cmd') -ArgumentList '--host','codex').ExitCode\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/te-hook\" --host codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"exit (Start-Process -Wait -NoNewWindow -PassThru -FilePath (Join-Path ([string]::Concat([Environment]::GetEnvironmentVariable('PLUGIN_ROOT','Process'),[Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT','Process'))) 'scripts\\te-hook.cmd') -ArgumentList '--host','codex').ExitCode\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/te-hook\" --host codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"exit (Start-Process -Wait -NoNewWindow -PassThru -FilePath (Join-Path ([string]::Concat([Environment]::GetEnvironmentVariable('PLUGIN_ROOT','Process'),[Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT','Process'))) 'scripts\\te-hook.cmd') -ArgumentList '--host','codex').ExitCode\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/te-hook\" --host codex",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"exit (Start-Process -Wait -NoNewWindow -PassThru -FilePath (Join-Path ([string]::Concat([Environment]::GetEnvironmentVariable('PLUGIN_ROOT','Process'),[Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT','Process'))) 'scripts\\te-hook.cmd') -ArgumentList '--host','codex').ExitCode\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
